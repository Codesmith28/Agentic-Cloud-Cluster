# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGODB_DATABASE=agentic_cluster

# Server Ports
GRPC_PORT=:50051
HTTP_PORT=:8080
MASTER_BIND_ADDR=
MASTER_ADVERTISE_ADDR=

# JWT Authentication
# IMPORTANT: Generate a strong random secret before deploying.
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32
# Optional auth cookie override: true/false.
# Default auto-mode keeps Secure=true except localhost/loopback HTTP.
AUTH_COOKIE_SECURE=

# Web UI default admin bootstrap (created on startup if missing)
WEBUI_ADMIN_NAME=Web UI Admin
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_PASSWORD=ChangeMeAdmin123!
# Set true to rotate existing admin password on startup
WEBUI_ADMIN_RESET_PASSWORD=false

# File Storage
AGENTIC_FILES_DIR=/var/agentic/files
# Legacy fallback: CLOUDAI_FILES_DIR
