# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_USERNAME=admin
MONGODB_PASSWORD=CHANGE_ME_MONGO_PASSWORD
MONGODB_DATABASE=cloudai

# Server Ports
GRPC_PORT=:50051
HTTP_PORT=:8080
MASTER_BIND_ADDR=
MASTER_ADVERTISE_ADDR=

# JWT Authentication
# IMPORTANT: Generate a strong random secret before deploying.
# Example: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# File Storage
CLOUDAI_FILES_DIR=/var/cloudai/files
