FROM golang:1.24.9 AS builder

WORKDIR /src

COPY go.work go.work.sum ./
COPY pkg ./pkg
COPY proto ./proto
COPY worker ./worker

# Ensure proto import path is available inside the worker module.
RUN rm -f /src/worker/proto && ln -s ../proto/pb /src/worker/proto

RUN cd /src/worker && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/workerNode .

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/workerNode /app/workerNode

ENV WORKER_PORT=50052
ENV WORKER_BIND_IP=0.0.0.0
ENV AGENTIC_WORKER_STATE_DIR=/var/lib/agentic/worker
ENV CLOUDAI_WORKER_STATE_DIR=/var/lib/agentic/worker
ENV AGENTIC_OUTPUT_DIR=/var/agentic/outputs
ENV CLOUDAI_OUTPUT_DIR=/var/agentic/outputs

RUN adduser --disabled-password --gecos "" agentic && \
    mkdir -p /var/lib/agentic/worker /var/agentic/outputs /var/lib/cloudai/worker /var/cloudai/outputs && \
    chown -R agentic:agentic /app /var/lib/agentic/worker /var/agentic/outputs /var/lib/cloudai/worker /var/cloudai/outputs

USER agentic

EXPOSE 50052

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/app/workerNode", "--healthcheck"] || exit 1

ENTRYPOINT ["/app/workerNode"]
