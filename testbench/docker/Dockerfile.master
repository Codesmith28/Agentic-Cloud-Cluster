FROM golang:1.24.9 AS builder

WORKDIR /src

COPY go.work go.work.sum ./
COPY pkg ./pkg
COPY proto ./proto
COPY master ./master

# Ensure proto import path is available inside the master module.
RUN rm -f /src/master/proto && ln -s ../proto/pb /src/master/proto

RUN cd /src/master && CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /out/masterNode .

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /out/masterNode /app/masterNode
COPY master/config /app/config

ENV AGENTIC_HEADLESS=true
ENV SCHED_ALGO=RTS
ENV PPO_AUTOSTART=false
ENV GRPC_PORT=:50051
ENV HTTP_PORT=:8080
ENV AGENTIC_FILES_DIR=/var/agentic/files

RUN adduser --disabled-password --gecos "" agentic && \
    mkdir -p /var/agentic/files && \
    chown -R agentic:agentic /app /var/agentic/files

USER agentic

EXPOSE 50051 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/app/masterNode", "--healthcheck"] || exit 1

ENTRYPOINT ["/app/masterNode"]
