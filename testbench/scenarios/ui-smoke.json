{
  "suite": "ui-smoke",
  "description": "Light UI and auth smoke checks against a live master API.",
  "runner": "ui-smoke",
  "ui_url": "http://localhost:3000",
  "master_url": "http://localhost:8080",
  "assertions": [
    "api-health",
    "api-workers",
    "api-tasks",
    "auth-register-login-me",
    "ui-root-loads"
  ]
}
