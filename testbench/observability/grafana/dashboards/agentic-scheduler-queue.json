{
  "uid": "agentic-scheduler-queue",
  "title": "Agentic Cloud Cluster Scheduler & Queue",
  "description": "Scheduler performance, latency distribution, and queue analytics",
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "scheduler",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
        "definition": "label_values(agentic_master_scheduling_latency_seconds_bucket, scheduler)",
        "query": "label_values(agentic_master_scheduling_latency_seconds_bucket, scheduler)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "task_type",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
        "definition": "label_values(agentic_master_task_terminal_total, task_type)",
        "query": "label_values(agentic_master_task_terminal_total, task_type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latency Stats",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P50 Scheduling Latency",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(agentic_master_scheduling_latency_seconds_bucket{scheduler=~\"$scheduler\"}[5m])) by (le))",
          "legendFormat": "P50"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Scheduling Latency",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(agentic_master_scheduling_latency_seconds_bucket{scheduler=~\"$scheduler\"}[5m])) by (le))",
          "legendFormat": "P95"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P99 Queue Wait",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(agentic_master_task_queue_wait_seconds_bucket{scheduler=~\"$scheduler\", task_type=~\"$task_type\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Latency Distribution",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 6,
      "type": "heatmap",
      "title": "Scheduling Latency Distribution",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentic_master_scheduling_latency_seconds_bucket{scheduler=~\"$scheduler\"}[5m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "cellGap": 1
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 7,
      "type": "heatmap",
      "title": "Queue Wait Distribution",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentic_master_task_queue_wait_seconds_bucket{scheduler=~\"$scheduler\", task_type=~\"$task_type\"}[5m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": { "unit": "s" },
        "color": { "scheme": "Oranges", "mode": "scheme" },
        "cellGap": 1
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Selections & Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Worker Selections",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (scheduler, task_type) (rate(agentic_master_scheduler_selections_total{scheduler=~\"$scheduler\", task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "{{scheduler}} / {{task_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Queue Throughput",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentic_master_tasks_enqueued_total[5m]))",
          "legendFormat": "Enqueued/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(agentic_master_tasks_dequeued_total[5m]))",
          "legendFormat": "Dequeued/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Terminal States",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Task Terminal States",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(agentic_master_task_terminal_total{task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "lineWidth": 2,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Benchmark Flow",
      "datasource": { "type": "prometheus", "uid": "agentic-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agentic_master_tasks_enqueued_total[5m]))",
          "legendFormat": "Enqueued/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(agentic_master_tasks_dequeued_total[5m]))",
          "legendFormat": "Dequeued/s"
        },
        {
          "refId": "C",
          "expr": "sum(rate(agentic_master_task_requeues_total{task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "Requeued/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    }
  ]
}
