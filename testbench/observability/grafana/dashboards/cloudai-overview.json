{
  "uid": "cloudai-overview",
  "title": "CloudAI Overview",
  "description": "Main operational dashboard for the CloudAI distributed task scheduling system",
  "schemaVersion": 41,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "scheduler",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
        "definition": "label_values(cloudai_master_scheduling_latency_seconds_bucket, scheduler)",
        "query": "label_values(cloudai_master_scheduling_latency_seconds_bucket, scheduler)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      },
      {
        "name": "task_type",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
        "definition": "label_values(cloudai_master_task_terminal_total, task_type)",
        "query": "label_values(cloudai_master_task_terminal_total, task_type)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Key Metrics",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Current Queue Depth",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudai_master_queue_depth",
          "legendFormat": "Queue Depth"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Running Tasks",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(cloudai_worker_running_tasks)",
          "legendFormat": "Running Tasks"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Workers",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 5, "w": 4, "x": 10, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "count(cloudai_worker_running_tasks)",
          "legendFormat": "Workers"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Task Success Rate",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 14, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cloudai_master_task_terminal_total{status=\"completed\", task_type=~\"$task_type\"}[5m])) / sum(rate(cloudai_master_task_terminal_total{task_type=~\"$task_type\"}[5m])) * 100",
          "legendFormat": "Success %"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Avg Scheduling Latency",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(cloudai_master_scheduling_latency_seconds_bucket{scheduler=~\"$scheduler\"}[5m])) by (le))",
          "legendFormat": "P50 Latency"
        }
      ],
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Queue & Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue Depth",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudai_master_queue_depth",
          "legendFormat": "Queue Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "gradientMode": "scheme",
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Task Throughput",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(cloudai_master_tasks_enqueued_total{task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "Enqueued/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(cloudai_master_tasks_dequeued_total{task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "Dequeued/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Workers",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker Resource Usage",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudai_worker_resource_usage_ratio{resource=\"cpu\"}",
          "legendFormat": "{{instance}} - CPU"
        },
        {
          "refId": "B",
          "expr": "cloudai_worker_resource_usage_ratio{resource=\"memory\"}",
          "legendFormat": "{{instance}} - Memory"
        },
        {
          "refId": "C",
          "expr": "cloudai_worker_resource_usage_ratio{resource=\"storage\"}",
          "legendFormat": "{{instance}} - Storage"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Worker Running Tasks",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "cloudai_worker_running_tasks",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 15,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Errors",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Task Failures & Requeues",
      "datasource": { "type": "prometheus", "uid": "cloudai-prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 25 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (failure_reason) (rate(cloudai_master_task_requeues_total{task_type=~\"$task_type\"}[5m]))",
          "legendFormat": "Requeues - {{failure_reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (worker_id) (rate(cloudai_master_worker_timeouts_total[5m]))",
          "legendFormat": "Timeouts - {{worker_id}}"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(cloudai_master_stale_results_total[5m]))",
          "legendFormat": "Stale Results - {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    }
  ]
}
