{
  "name": "failure-helpers",
  "description": "Deterministic helper workload for failure-path validation (non-zero exits, startup delays, and hang behavior).",
  "tasks": [
    {
      "docker_image": "agentic/workflow-deterministic:v1",
      "workflow": {
        "profile": "exit-nonzero",
        "args": {
          "code": 23,
          "seed": 9001
        }
      },
      "cpu_required": 0.3,
      "memory_required": 0.25,
      "storage_required": 1,
      "tag": "cpu-light",
      "k_value": 2.0
    },
    {
      "docker_image": "agentic/workflow-deterministic:v1",
      "workflow": {
        "profile": "slow-start",
        "args": {
          "delay-seconds": 45,
          "iterations": 900000,
          "seed": 9002
        }
      },
      "cpu_required": 0.8,
      "memory_required": 0.5,
      "storage_required": 1,
      "tag": "mixed",
      "k_value": 2.0,
      "arrival_delay_sec": 1
    },
    {
      "docker_image": "agentic/workflow-deterministic:v1",
      "workflow": {
        "profile": "hang",
        "args": {
          "tick-seconds": 5,
          "max-seconds": 90,
          "seed": 9003
        }
      },
      "cpu_required": 0.4,
      "memory_required": 0.5,
      "storage_required": 1,
      "tag": "memory-heavy",
      "k_value": 2.0,
      "arrival_delay_sec": 1
    }
  ]
}
