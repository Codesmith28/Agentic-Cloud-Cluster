{
  "name": "heterogeneous-smoke",
  "description": "Mixed CPU, memory, and I/O workload to validate heterogeneous worker scheduling.",
  "tasks": [
    {
      "docker_image": "alpine:3.20",
      "command": "echo 'task-01 hello' > /output/result.txt; sleep 1",
      "cpu_required": 0.5,
      "memory_required": 0.25,
      "storage_required": 1,
      "gpu_required": 0,
      "tag": "cpu-light",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "i=0; while [ $i -lt 900000 ]; do i=$((i+1)); done; echo $i > /output/iterations.txt",
      "cpu_required": 1.0,
      "memory_required": 0.5,
      "storage_required": 1,
      "gpu_required": 0,
      "tag": "cpu-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "dd if=/dev/zero of=/tmp/blob bs=1M count=128 >/dev/null 2>&1; wc -c /tmp/blob > /output/blob-size.txt",
      "cpu_required": 0.7,
      "memory_required": 1.0,
      "storage_required": 2,
      "gpu_required": 0,
      "tag": "memory-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "yes cloudai | head -n 300000 > /tmp/stream.txt; wc -l /tmp/stream.txt > /output/lines.txt",
      "cpu_required": 1.2,
      "memory_required": 1.2,
      "storage_required": 2,
      "gpu_required": 0,
      "tag": "mixed",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "sleep 2; echo 'task-05 done' > /output/done.txt",
      "cpu_required": 0.4,
      "memory_required": 0.25,
      "storage_required": 1,
      "gpu_required": 0,
      "tag": "cpu-light",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "i=0; while [ $i -lt 1200000 ]; do i=$((i+1)); done; echo $i > /output/iterations.txt",
      "cpu_required": 1.5,
      "memory_required": 0.75,
      "storage_required": 1,
      "gpu_required": 0,
      "tag": "cpu-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "dd if=/dev/zero of=/tmp/blob bs=1M count=192 >/dev/null 2>&1; wc -c /tmp/blob > /output/blob-size.txt",
      "cpu_required": 0.8,
      "memory_required": 1.5,
      "storage_required": 3,
      "gpu_required": 0,
      "tag": "memory-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "yes bench | head -n 450000 > /tmp/stream.txt; wc -l /tmp/stream.txt > /output/lines.txt",
      "cpu_required": 1.6,
      "memory_required": 1.0,
      "storage_required": 2,
      "gpu_required": 0,
      "tag": "mixed",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "sleep 3; echo 'task-09 complete' > /output/done.txt",
      "cpu_required": 0.5,
      "memory_required": 0.25,
      "storage_required": 1,
      "gpu_required": 0,
      "tag": "cpu-light",
      "k_value": 2.0
    },
    {
      "docker_image": "alpine:3.20",
      "command": "i=0; while [ $i -lt 1500000 ]; do i=$((i+1)); done; echo $i > /output/iterations.txt",
      "cpu_required": 2.0,
      "memory_required": 1.25,
      "storage_required": 2,
      "gpu_required": 0,
      "tag": "cpu-heavy",
      "k_value": 2.0
    }
  ]
}
