{
  "name": "heterogeneous-smoke",
  "description": "Mixed CPU, memory, and balanced benchmark profiles using the repo-owned deterministic workflow image.",
  "tasks": [
    {
      "docker_image": "cloudai-benchmark:1",
      "workflow_profile": "cpu-light",
      "workflow_args": {
        "seed": 101,
        "iterations": 18000,
        "sleep_ms": 90,
        "output": "cpu-light-01.csv"
      },
      "cpu_required": 0.5,
      "memory_required": 0.25,
      "storage_required": 1,
      "tag": "cpu-light",
      "k_value": 2.0
    },
    {
      "docker_image": "cloudai-benchmark:1",
      "workflow_profile": "cpu-heavy",
      "workflow_args": {
        "seed": 201,
        "iterations": 9500,
        "sleep_ms": 120,
        "output": "cpu-heavy-01.csv"
      },
      "cpu_required": 1.0,
      "memory_required": 0.5,
      "storage_required": 1,
      "tag": "cpu-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "cloudai-benchmark:1",
      "workflow_profile": "memory-heavy",
      "workflow_args": {
        "seed": 301,
        "chunks": 7,
        "chunk_kib": 320,
        "passes": 3,
        "sleep_ms": 160,
        "output": "memory-heavy-01.csv"
      },
      "cpu_required": 0.7,
      "memory_required": 1.0,
      "storage_required": 2,
      "tag": "memory-heavy",
      "k_value": 2.0
    },
    {
      "docker_image": "cloudai-benchmark:1",
      "workflow_profile": "mixed",
      "workflow_args": {
        "seed": 401,
        "iterations": 128,
        "chunks": 6,
        "chunk_kib": 224,
        "sleep_ms": 120,
        "output": "mixed-01.csv"
      },
      "cpu_required": 1.2,
      "memory_required": 1.2,
      "storage_required": 2,
      "tag": "mixed",
      "k_value": 2.0
    },
    {
      "docker_image": "cloudai-benchmark:1",
