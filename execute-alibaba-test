#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# execute-alibaba-test — End-to-end Alibaba benchmark with online/offline PPO
#
# Orchestrates a complete benchmark campaign comparing:
#   - RR (Round-Robin)
#   - RTS (Resource-based Task Scheduling)
#   - PPO (offline trained)
#   - PPO (online adaptive)
#
# On Alibaba-derived test workloads with:
#   - CPU-heavy tasks
#   - Memory-heavy tasks
#   - Mixed workloads
#   - Bursty patterns
#
# Usage:
#   ./execute-alibaba-test                          # Run with defaults
#   ./execute-alibaba-test --offline                # Only offline PPO
#   ./execute-alibaba-test --online                 # Only online PPO
#   ./execute-alibaba-test --skip-build             # Skip Go build
#   ./execute-alibaba-test --tasks 500000           # Custom task count
#   ./execute-alibaba-test --start-row 1000000      # Custom start row
#   ./execute-alibaba-test --teardown               # Cleanup only
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${SCRIPT_DIR}"

# ── Defaults ─────────────────────────────────────────────────────────────────
OFFLINE_MODE=true
ONLINE_MODE=true
SKIP_BUILD=false
TEARDOWN_ONLY=false
MASTER_URL="http://localhost:8080"
COMPOSE_FILE="testbench/docker-compose.host-master.yml"
WORKER_SPECS="worker-small=localhost:55052,worker-medium=localhost:55053,worker-large=localhost:55054"

# Alibaba test parameters
ALIBABA_TEST_SOURCE_DIR="${ALIBABA_TEST_SOURCE_DIR:-agentic_scheduler/data/alibaba_v2018/core}"
ALIBABA_TEST_TRACE_DIR="${ALIBABA_TEST_TRACE_DIR:-agentic_scheduler/data/alibaba_v2018/alibaba_test}"
ALIBABA_TEST_TASKS="${ALIBABA_TEST_TASKS:-100000}"
ALIBABA_TEST_START_ROW="${ALIBABA_TEST_START_ROW:-0}"
ALIBABA_TEST_TASKS_PER_WORKLOAD="${ALIBABA_TEST_TASKS_PER_WORKLOAD:-30}"

# PPO training parameters
PPO_OFFLINE_MODEL="agentic_scheduler/results/ppo_offline_alibaba.pt"
PPO_OFFLINE_UPDATES="${PPO_OFFLINE_UPDATES:-50}"
CHECKPOINT_DIR="agentic_scheduler/results/checkpoints"

# Online PPO tuning parameters
# Online PPO starts from frozen offline model and fine-tunes on replay batches during benchmark
ONLINE_PPO_REPLAY_BATCH_SIZE="${ONLINE_PPO_REPLAY_BATCH_SIZE:-100}"
ONLINE_PPO_LR_SCALE="${ONLINE_PPO_LR_SCALE:-0.1}"

# Results
RESULTS_DIR="results/alibaba-test-$(date +%Y%m%d-%H%M%S)"
CAMPAIGN_REPORT="${RESULTS_DIR}/campaign-report.json"
COMPARISON_REPORT="${RESULTS_DIR}/comparison.md"

# Master and workers
MASTER_PID=""
MASTER_BIN="master/masterNode"

# Environment setup
export GF_ADMIN_PASSWORD="${GF_ADMIN_PASSWORD:-password}"
export MONGO_PASSWORD="${MONGO_PASSWORD:-cloudai-stress-test}"
export MONGO_USERNAME="${MONGO_USERNAME:-cloudai}"

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ── Helper functions ─────────────────────────────────────────────────────────
separator() {
    echo ""
    echo -e "${BLUE}================================================================================${NC}"
    echo -e "${BLUE}  $1${NC}"
    echo -e "${BLUE}================================================================================${NC}"
}

ok() {
    echo -e "${GREEN}✓ $1${NC}"
}

warn() {
    echo -e "${YELLOW}⚠ $1${NC}"
}

error() {
    echo -e "${RED}✗ $1${NC}"
}

require_venv() {
    if [[ ! -d "venv" ]]; then
        error "Virtual environment not found at ./venv"
        exit 1
    fi
}

# ── Cleanup function ─────────────────────────────────────────────────────────
cleanup() {
    if [[ -n "${MASTER_PID}" ]]; then
        warn "Shutting down master node (PID: ${MASTER_PID})"
        kill "${MASTER_PID}" 2>/dev/null || true
        wait "${MASTER_PID}" 2>/dev/null || true
    fi

    warn "Tearing down Docker stack..."
    docker compose -f "${COMPOSE_FILE}" down --remove-orphans 2>/dev/null || true
    sleep 2
    ok "Cleanup complete"
}

trap cleanup EXIT

# ── Parse arguments ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
    --offline)
        OFFLINE_MODE=true
        ONLINE_MODE=false
        shift
        ;;
    --online)
        OFFLINE_MODE=false
        ONLINE_MODE=true
        shift
        ;;
    --skip-build)
        SKIP_BUILD=true
        shift
        ;;
    --teardown)
        TEARDOWN_ONLY=true
        shift
        ;;
    --tasks)
        ALIBABA_TEST_TASKS="$2"
        shift 2
        ;;
    --start-row)
        ALIBABA_TEST_START_ROW="$2"
        shift 2
        ;;
    --tasks-per-workload)
        ALIBABA_TEST_TASKS_PER_WORKLOAD="$2"
        shift 2
        ;;
    --offline-updates)
        PPO_OFFLINE_UPDATES="$2"
        shift 2
        ;;
    --online-replay-batch)
        ONLINE_PPO_REPLAY_BATCH_SIZE="$2"
        shift 2
        ;;
    --online-lr-scale)
        ONLINE_PPO_LR_SCALE="$2"
        shift 2
        ;;
    --help)
        cat << EOF
execute-alibaba-test — Comprehensive Alibaba test benchmark

Usage: ./execute-alibaba-test [OPTIONS]

Options:
    --offline                   Run offline PPO only (default: both)
    --online                    Run online PPO only (default: both)
    --skip-build                Skip Go build step
    --teardown                  Cleanup only (don't run tests)
    --tasks N                   Task count for test split (default: 100000)
    --start-row N               Start row for contiguous split (default: auto-tail)
    --tasks-per-workload N      Tasks per workload (default: 30)
    --offline-updates N         PPO offline training updates (default: 50)
    --online-replay-batch N     Online PPO replay batch size (default: 100)
    --online-lr-scale F         Online PPO learning rate scale [0-1] (default: 0.1)
    --help                      Show this help message

Examples:
    ./execute-alibaba-test                      # Fast benchmark (~3h)
    ./execute-alibaba-test --offline            # Offline only (~1.5h)
    ./execute-alibaba-test --tasks 150000       # Larger split
    ./execute-alibaba-test --online-lr-scale 0.05  # Less aggressive tuning
EOF
        exit 0
        ;;
    *)
        error "Unknown option: $1"
        exit 1
        ;;
    esac
done

# ── Teardown-only mode ───────────────────────────────────────────────────────
if [[ "${TEARDOWN_ONLY}" == "true" ]]; then
    separator "Cleanup mode"
    cleanup
    exit 0
fi

# ── Check dependencies ───────────────────────────────────────────────────────
separator "Checking dependencies"
require_venv

VENV_PYTHON="venv/bin/python"
if [[ ! -f "${VENV_PYTHON}" ]]; then
    error "Python venv not found"
    exit 1
fi
ok "Python venv ready"

if ! command -v docker &> /dev/null; then
    error "Docker not found"
    exit 1
fi
ok "Docker ready"

if ! command -v go &> /dev/null; then
    error "Go not found"
    exit 1
fi
ok "Go ready"

# ── Step 1: Build Go binaries (if needed) ────────────────────────────────────
if [[ "${SKIP_BUILD}" != "true" ]]; then
    separator "Step 1: Building Go binaries"
    cd master
    go build -o masterNode ./cmd/master
    cd ..
    cd worker
    go build -o workerNode ./cmd/worker
    cd ..
    ok "Go binaries built"
else
    ok "Skipping Go build"
fi

# ── Step 2: Create Alibaba test split ────────────────────────────────────────
separator "Step 2: Creating Alibaba test split"
mkdir -p "${ALIBABA_TEST_TRACE_DIR}"

"${VENV_PYTHON}" agentic_scheduler/scripts/create_alibaba_test_split.py \
    --source-trace-dir "${ALIBABA_TEST_SOURCE_DIR}" \
    --dest-trace-dir "${ALIBABA_TEST_TRACE_DIR}" \
    --task-count "${ALIBABA_TEST_TASKS}" \
    --start-row "${ALIBABA_TEST_START_ROW}" \
    --force

ok "Test split created"

# ── Step 3: Generate test workloads ──────────────────────────────────────────
separator "Step 3: Generating test workloads"
mkdir -p testbench/workloads

"${VENV_PYTHON}" testbench/scripts/generate_alibaba_test_workloads.py \
    --trace-dir "${ALIBABA_TEST_TRACE_DIR}" \
    --output-dir testbench/workloads \
    --tasks-per-workload "${ALIBABA_TEST_TASKS_PER_WORKLOAD}"

ok "Test workloads generated"

# ── Step 4: Train or prepare models ──────────────────────────────────────────
mkdir -p "${CHECKPOINT_DIR}" "$(dirname "${PPO_OFFLINE_MODEL}")" "$(dirname "${PPO_ONLINE_BASE_MODEL}")"

# ── Step 4: Train offline PPO model ─────────────────────────────────────────
mkdir -p "${CHECKPOINT_DIR}" "$(dirname "${PPO_OFFLINE_MODEL}")"

if [[ "${OFFLINE_MODE}" == "true" ]] || [[ "${ONLINE_MODE}" == "true" ]]; then
    separator "Step 4: Training offline PPO model (${PPO_OFFLINE_UPDATES} updates)"
    
    # Train offline PPO — this will be used as:
    # - The frozen policy for offline PPO scheduler runs
    # - The starting point for online PPO (which tunes it during benchmark)
    "${VENV_PYTHON}" -m agentic_scheduler.train_ppo \
        --trace-source alibaba \
        --trace-path "${ALIBABA_TEST_TRACE_DIR}" \
        --max-trace-tasks "${ALIBABA_TEST_TASKS}" \
        --rollout-steps 8192 \
        --minibatch-size 2048 \
        --ppo-epochs 3 \
        --updates "${PPO_OFFLINE_UPDATES}" \
        --checkpoint-every 10 \
        --output "${PPO_OFFLINE_MODEL}" \
        --checkpoint-dir "${CHECKPOINT_DIR}" \
        --checkpoint-prefix "ppo_offline_alibaba" \
        --num-workers 8 \
        --log-every 5
    
    ok "Offline PPO model trained: ${PPO_OFFLINE_MODEL}"
fi

# ── Step 5: Start Docker stack ───────────────────────────────────────────────
separator "Step 5: Starting Docker stack"

docker compose -f "${COMPOSE_FILE}" down --remove-orphans 2>/dev/null || true
sleep 2

docker compose -f "${COMPOSE_FILE}" up -d
sleep 5

# Verify services started
if ! docker compose -f "${COMPOSE_FILE}" ps | grep -q "healthy"; then
    warn "Services not fully healthy yet, waiting..."
    sleep 10
fi

ok "Docker stack started"

# ── Step 6: Start local master node ──────────────────────────────────────────
separator "Step 6: Starting local master node"

if [[ ! -f "${MASTER_BIN}" ]]; then
    error "Master binary not found at ${MASTER_BIN}"
    exit 1
fi

export PPO_REPLAY_BATCH="${ONLINE_PPO_REPLAY_BATCH_SIZE}"
"${MASTER_BIN}" > /tmp/master.log 2>&1 &
MASTER_PID=$!
sleep 3

# Verify master is responsive
if ! curl -s "${MASTER_URL}/api/health" > /dev/null; then
    error "Master node not responding at ${MASTER_URL}"
    cat /tmp/master.log
    exit 1
fi

ok "Master node started (PID: ${MASTER_PID})"

# ── Step 7: Register workers ─────────────────────────────────────────────────
separator "Step 7: Registering workers"

for spec in $(echo "${WORKER_SPECS}" | tr ',' '\n'); do
    name="${spec%=*}"
    addr="${spec#*=}"
    
    for retry in 1 2 3; do
        if "${VENV_PYTHON}" testbench/scripts/register_worker.py \
            --worker-name "${name}" \
            --worker-addr "${addr}" \
            --master-url "${MASTER_URL}"; then
            ok "Registered ${name} at ${addr}"
            break
        else
            if [[ $retry -lt 3 ]]; then
                warn "Registration failed for ${name}, retrying..."
                sleep 2
            else
                error "Failed to register ${name} after 3 attempts"
                exit 1
            fi
        fi
    done
done

# ── Step 8: Prepare results directory ────────────────────────────────────────
separator "Step 8: Preparing results directory"
mkdir -p "${RESULTS_DIR}"
ok "Results will be saved to: ${RESULTS_DIR}"

# ── Step 9: Run campaigns ────────────────────────────────────────────────────
separator "Step 9: Running benchmark campaigns"

SCHEDULERS=("RR" "RTS")
[[ "${OFFLINE_MODE}" == "true" ]] && SCHEDULERS+=("PPO")
[[ "${ONLINE_MODE}" == "true" ]] && SCHEDULERS+=("PPO_ONLINE")

WORKLOADS=("alibaba-test-cpu" "alibaba-test-memory" "alibaba-test-mixed" "alibaba-test-bursty")

TOTAL_RUNS=$((${#SCHEDULERS[@]} * ${#WORKLOADS[@]} * 3))  # 3 scenarios
CURRENT_RUN=0

for scheduler in "${SCHEDULERS[@]}"; do
    # Select model if PPO
    if [[ "${scheduler}" == "PPO" ]]; then
        MODEL_TO_USE="${PPO_OFFLINE_MODEL}"
        SCHEDULER_ALGO="PPO"
        EXTRA_ARGS=""
    elif [[ "${scheduler}" == "PPO_ONLINE" ]]; then
        MODEL_TO_USE="${PPO_OFFLINE_MODEL}"  # Start from offline model
        SCHEDULER_ALGO="PPO"
        # Pass online tuning parameters
        EXTRA_ARGS="--online-mode --replay-batch-size ${ONLINE_PPO_REPLAY_BATCH_SIZE} --online-lr-scale ${ONLINE_PPO_LR_SCALE}"
    else
        MODEL_TO_USE=""
        SCHEDULER_ALGO="${scheduler}"
        EXTRA_ARGS=""
    fi

    for workload in "${WORKLOADS[@]}"; do
        for scenario in "baseline" "burst" "overload"; do
            CURRENT_RUN=$((CURRENT_RUN + 1))
            echo ""
            echo -e "${BLUE}[${CURRENT_RUN}/${TOTAL_RUNS}] Running: ${scheduler} × ${workload} × ${scenario}${NC}"

            # Switch scheduler
            if ! "${VENV_PYTHON}" testbench/scripts/set_scheduler.py \
                --master-url "${MASTER_URL}" \
                --scheduler "${SCHEDULER_ALGO}" \
                --model "${MODEL_TO_USE}" \
                ${EXTRA_ARGS}; then
                error "Failed to set scheduler to ${SCHEDULER_ALGO}"
                continue
            fi

            # Run workload via run_campaign.py
            WORKLOAD_RESULT="${RESULTS_DIR}/${scheduler}-${workload}-${scenario}.json"
            
            if "${VENV_PYTHON}" testbench/scripts/run_campaign.py \
                --master-url "${MASTER_URL}" \
                --scenarios "${scenario}" \
                --workloads "${workload}" \
                --output-dir "${RESULTS_DIR}" \
                --output-file "$(basename "${WORKLOAD_RESULT}")"; then
                ok "Completed: ${scheduler} × ${workload} × ${scenario}"
            else
                error "Failed: ${scheduler} × ${workload} × ${scenario}"
            fi
        done
    done
done

# ── Step 10: Generate comparison report ──────────────────────────────────────
separator "Step 10: Generating comparison report"

"${VENV_PYTHON}" testbench/scripts/generate_comparison_report.py \
    --results-dir "${RESULTS_DIR}" \
    --output "${COMPARISON_REPORT}"

if [[ -f "${COMPARISON_REPORT}" ]]; then
    ok "Comparison report generated: ${COMPARISON_REPORT}"
    echo ""
    cat "${COMPARISON_REPORT}"
else
    warn "Could not generate comparison report"
fi

# ── Summary ──────────────────────────────────────────────────────────────────
separator "Benchmark Complete"
echo ""
echo "Results saved to: ${RESULTS_DIR}"
echo ""
echo "Files generated:"
ls -lh "${RESULTS_DIR}"
echo ""
ok "Done!"
